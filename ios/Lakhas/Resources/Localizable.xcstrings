    "token.serverNotConfigured": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُضبط عنوان الخادم في هذه النسخة بعد. يمكنك المتابعة بدون خادم الآن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no server address yet. You can continue without the server for now."
          }
        }
      }
    },
    "token.skipNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تسجيل وجباتك يدويًا بدون رمز. التحليل بالذكاء الاصطناعي والباركود يحتاجان الرمز، ويمكنك إضافته لاحقًا من الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can log meals manually without a token. AI analysis and barcode lookup need one; you can add it later in Settings."
          }
        }
      }
    },
    "token.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رمز الجهاز من لوحة التحكم أو امسح رمز QR. ستحتاجه مرة واحدة فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the device token from the admin panel or scan its QR code. You only need to do this once."
          }
        }
      }
    },
