    "token.error.clock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت الجهاز غير مضبوط. فعّل الضبط التلقائي للوقت ثم حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device clock is off. Turn on automatic time, then try again."
          }
        }
      }
    },
    "token.error.format": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا لا يبدو رمز جهاز صحيحًا. انسخ الرمز كاملًا من لوحة التحكم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a device token. Copy the whole token from the admin panel."
          }
        }
      }
    },
    "token.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ غير متوقع. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        }
      }
    },
    "token.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز غير صالح أو تم إلغاؤه. أنشئ رمزًا جديدًا من لوحة التحكم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This token isn't valid or was revoked. Create a new one in the admin panel."
          }
        }
      }
    },
    "token.error.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the server. Check your connection and try again."
          }
        }
      }
    },
    "token.error.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
