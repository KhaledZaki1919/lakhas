    "ai.error.badRequest": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزوّد الطلب. جرّب نموذجًا آخر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected the request. Try another model."
          }
        }
      }
    },
    "ai.error.credit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد رصيد كافٍ في حسابك لدى المزوّد. أضف رصيدًا ثم حاول."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider account is out of credit. Add credit and try again."
          }
        }
      }
    },
    "ai.error.dailyLimit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت للحد اليومي الذي حددته. يمكنك تغييره من الإعدادات ← الذكاء الاصطناعي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached the daily limit you set. You can change it in Settings → AI."
          }
        }
      }
    },
    "ai.error.invalidKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح غير صحيح أو تم إلغاؤه. انسخه مرة أخرى من حساب المزوّد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is wrong or was revoked. Copy it again from your provider account."
          }
        }
      }
    },
    "ai.error.invalidOutput": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من فهم رد النموذج. حاول مرة أخرى أو جرّب نموذجًا آخر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't read the model's reply. Try again or pick another model."
          }
        }
      }
    },
    "ai.error.model": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا النموذج غير متاح لحسابك. اختر نموذجًا آخر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model isn't available to your account. Pick another one."
          }
        }
      }
    },
    "ai.error.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال. تحقق من الإنترنت وحاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect. Check your internet and try again."
          }
        }
      }
    },
    "ai.error.noKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح API أولًا من الإعدادات ← الذكاء الاصطناعي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an API key first in Settings → AI."
          }
        }
      }
    },
    "ai.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات كثيرة في وقت قصير أو نفدت الحصة المجانية. انتظر قليلًا (أو حتى الغد) ثم حاول."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests, or the free quota is used up. Wait a moment (or until tomorrow) and try again."
          }
        }
      }
    },
    "ai.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض النموذج هذا الطلب. جرّب صورة أو وصفًا آخر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model declined this request. Try another photo or description."
          }
        }
      }
    },
    "ai.error.truncated": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرد كان طويلًا جدًا. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reply was too long. Try again."
          }
        }
      }
    },
    "ai.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة المزوّد مشغولة أو متوقفة الآن. حاول بعد قليل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider is busy or down right now. Try again shortly."
          }
        }
      }
    },
    "ai.highAccuracy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دقة عالية لتحليل الصور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High accuracy for photos"
          }
        }
      }
    },
    "ai.highAccuracy.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، يُحلَّل تصوير الوجبات بنموذج أقوى (أدق وأغلى). الكتابة والتصحيح يبقيان على النموذج الأساسي الأرخص."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, meal photos use a stronger model (more accurate, more expensive). Text entry and corrections stay on the cheaper standard model."
          }
        }
      }
    },
    "ai.key.delete": {
      "extractionState": "manual",
