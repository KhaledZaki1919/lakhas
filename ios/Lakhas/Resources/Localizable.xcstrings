    "ai.key.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ المفتاح في سلسلة مفاتيح هذا الجهاز فقط. لا يُزامن ولا يدخل في النسخ الاحتياطية أو ملفات التصدير."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key is stored only in this iPhone's Keychain. It isn't synced or included in backups or exports."
          }
        }
      }
    },
