    "ai.privacy %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور والنصوص التي تحللها تُرسل مباشرة إلى %@ باستخدام مفتاحك. لا يوجد خادم لنا في المنتصف، ويُحاسبك المزوّد مباشرة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and text you analyze go directly to %@ with your key. There's no server of ours in between, and the provider bills you directly."
          }
        }
      }
    },
