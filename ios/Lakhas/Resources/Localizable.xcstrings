    "onboarding.ai.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتحليل صور وجباتك، أضف مفتاح API من مزوّد تختاره: Claude أو OpenAI أو Gemini أو OpenRouter. تدفع له مباشرة، وبياناتك لا تمر بنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
