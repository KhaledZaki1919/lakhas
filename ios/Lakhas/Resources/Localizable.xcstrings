    "nokey.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لخّص يستخدم مزوّد الذكاء الاصطناعي الذي تختاره، بمفتاحك الخاص. تدفع للمزوّد مباشرة حسب استخدامك، ولا تمر بياناتك عبر أي خادم لنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakhas uses the AI provider you choose, with your own key. You pay the provider directly for what you use, and your data never passes through a server of ours."
          }
        }
      }
    },
    "nokey.cost": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحليل صورة واحدة يكلّف عادة جزءًا صغيرًا من السنت مع النماذج الاقتصادية. ستظهر التكلفة التقديرية بعد كل تحليل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzing one photo usually costs a small fraction of a cent with economical models. You'll see an estimate after each analysis."
          }
        }
      }
    },
    "nokey.open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح إعدادات الذكاء الاصطناعي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AI settings"
          }
        }
      }
    },
    "nokey.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مزوّدًا وأنشئ حسابًا لديه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a provider and create an account there."
          }
        }
      }
    },
    "nokey.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ مفتاح API وانسخه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an API key and copy it."
          }
        }
      }
    },
    "nokey.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصقه في الإعدادات ← الذكاء الاصطناعي واضغط «اختبار الاتصال»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste it in Settings → AI and tap Test connection."
          }
        }
      }
    },
    "nokey.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاحك لتفعيل التحليل الذكي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your key to turn on AI analysis"
          }
        }
      }
    },
    "nokey.withoutKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون مفتاح، يمكنك تسجيل وجباتك يدويًا واستخدام باقي التطبيق كالمعتاد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a key, you can still log meals manually and use the rest of the app."
          }
        }
      }
    },
