{
  "name": "lakhas-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build:dry": "wrangler deploy --dry-run --outdir dist/api && wrangler deploy -c wrangler.admin.toml --dry-run --outdir dist/admin",
    "cf-typegen": "wrangler types --strict-vars false",
    "deploy:api": "wrangler deploy",
    "deploy:admin": "wrangler deploy -c wrangler.admin.toml",
    "migrate:remote": "wrangler d1 migrations apply lakhas --remote"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true
  }
}
